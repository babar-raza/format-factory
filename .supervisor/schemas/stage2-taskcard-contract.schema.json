{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 2 Taskcard Contract",
  "description": "Output contract for Plan Hardening (Prompt 2). Defines taskcard generation, plan delta, and execution readiness.",
  "type": "object",
  "required": ["sprint_id", "timestamp", "taskcards", "plan_verdict"],
  "properties": {
    "sprint_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "input_interpretation": { "type": "string" },
    "issues_extracted_count": { "type": "integer", "minimum": 0 },
    "hardening_score": {
      "type": "object",
      "required": ["achieved", "maximum"],
      "properties": {
        "achieved": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "taskcards": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskcard" }
    },
    "execution_dag": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskcard_id", "depends_on"],
        "properties": {
          "taskcard_id": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "lane_ownership_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane_id", "owner_role", "taskcard_ids"],
        "properties": {
          "lane_id": { "type": "string" },
          "owner_role": { "type": "string" },
          "taskcard_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "anti_overclaim_rules": { "type": "array", "items": { "type": "string" } },
    "reroute_rules": { "type": "array", "items": { "type": "string" } },
    "remaining_blockers": { "type": "array", "items": { "type": "string" } },
    "plan_verdict": {
      "type": "string",
      "enum": [
        "PLAN_HARDENED_FROM_AUDIT_READY_FOR_EXECUTION",
        "PLAN_HARDENED_FROM_AUDIT_WITH_PARTIAL_CONTEXT",
        "PLAN_NOT_READY_AUDIT_PLAN_MISMATCH",
        "PLAN_NOT_READY_MISSING_ACTIVE_PLAN",
        "PLAN_NOT_READY_MISSING_AUDIT_SUMMARY",
        "BLOCKED_EXTERNAL"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "taskcard": {
      "type": "object",
      "required": ["taskcard_id", "title", "status", "required_implementation", "acceptance_criteria"],
      "properties": {
        "taskcard_id": { "type": "string" },
        "title": { "type": "string" },
        "source_issue_ids": { "type": "array", "items": { "type": "string" } },
        "source_issue_level": { "type": "string" },
        "source_audit_finding": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "risk_addressed": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "completed_verified", "completed_but_weakly_verified", "partially_done",
            "not_attempted", "claimed_unproven", "blocker", "follow_up",
            "ready_for_execution", "blocked_external", "deferred_with_reason"
          ]
        },
        "lane_owner": { "type": "string" },
        "supervisor_role": { "type": "string" },
        "required_implementation": { "type": "string" },
        "required_verification": { "type": "string" },
        "required_evidence": { "type": "string" },
        "quality_dimensions": { "type": "array", "items": { "type": "string" } },
        "scoring_rubric": { "type": "string" },
        "reroute_rule_if_score_below_4": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "stop_conditions": { "type": "array", "items": { "type": "string" } },
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "closeout_rules": { "type": "string" },
        "machine_state": { "type": "string" },
        "validation_commands": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
