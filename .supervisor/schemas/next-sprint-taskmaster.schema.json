{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NextSprintTaskmaster",
  "description": "Schema for supervisor Task Master export — Format Factory dual-orchestration",
  "type": "object",
  "required": ["sprint_id", "timestamp", "verdict", "tasks"],
  "additionalProperties": false,
  "properties": {
    "sprint_id": {
      "type": "string",
      "description": "Sprint identity for this task export"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of export generation"
    },
    "verdict": {
      "type": "string",
      "description": "Evidence verdict that produced this task export"
    },
    "source_bundle": {
      "type": "string",
      "description": "Path to evidence bundle that generated these tasks"
    },
    "tasks": {
      "type": "array",
      "description": "List of tasks for Task Master to ingest",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["task_id", "title", "status", "acceptance_evidence", "validation_command"],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Unique task ID (e.g. TASK-001)"
          },
          "title": {
            "type": "string",
            "description": "Human-readable task title"
          },
          "description": {
            "type": "string",
            "description": "Detailed task description"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in-progress", "done", "blocked", "evidence-blocked", "approval-blocked"],
            "description": "Task status — must not be used to imply FF gate closure"
          },
          "ff_taskcard_ref": {
            "type": "string",
            "description": "Reference to Format Factory taskcard (e.g. TC-0057)"
          },
          "ff_gate_ref": {
            "type": "string",
            "description": "Reference to Format Factory gate (e.g. gate_10)"
          },
          "ff_doc_ref": {
            "type": "string",
            "description": "Reference to Format Factory doc (e.g. docs/taskmaster/taskmaster-supervisor-integration.md)"
          },
          "supervisor_task_ref": {
            "type": "string",
            "description": "Reference to supervisor taskcard (e.g. TC-SUP-007)"
          },
          "acceptance_evidence": {
            "type": "string",
            "description": "Evidence required to accept this task (file path or validation output)"
          },
          "validation_command": {
            "type": "string",
            "description": "Command to validate task completion"
          },
          "blocker_type": {
            "type": "string",
            "enum": ["external_gate", "credentials", "evidence_required", "human_approval", "governance_conflict"],
            "description": "Required when status is blocked or approval-blocked"
          },
          "non_authoritative": {
            "type": "boolean",
            "description": "Must be true for work-ahead tasks that precede evidence validation"
          },
          "lane": {
            "type": "string",
            "description": "Execution lane (e.g. C4)"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Human-readable notes about this export"
    }
  },
  "examples": [
    {
      "sprint_id": "supervisor-next-sprint-20260530",
      "timestamp": "2026-05-30T16:56:03",
      "verdict": "ACCEPTED",
      "source_bundle": "/path/to/r77.zip",
      "tasks": [
        {
          "task_id": "TASK-001",
          "title": "Implement FODS workbook_add_sheet API",
          "status": "pending",
          "ff_taskcard_ref": "TC-0057",
          "ff_gate_ref": "gate_10",
          "supervisor_task_ref": "TC-SUP-008",
          "acceptance_evidence": "reports/r78/test-log.txt with 0 failures",
          "validation_command": ".local/venv/Scripts/python -m pytest tests/python/fods/ -v"
        }
      ],
      "notes": "Generated from R77 evidence bundle"
    }
  ]
}
