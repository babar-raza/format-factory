{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://format-factory/schemas/execution-manifest.schema.json",
  "title": "Skills-First Execution Manifest",
  "description": "Machine-readable record binding a material agent action to a resolved skill BEFORE mutation begins. Referenced by docs/governance/skill-only-policy.yaml (SKILL-ONLY-POLICY-001) as the concrete skill-resolution + execution record. Created by tools/governance/skills_first/manifest.py.",
  "type": "object",
  "required": [
    "schema", "execution_id", "task_id", "agent_type", "requested_operation",
    "selected_skill_ids", "skill_hashes", "allowed_paths", "status", "created_at",
    "expires_at"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "enum": [
        "skills-first-control/execution-manifest@1",
        "skills-first-control/execution-manifest@2"
      ]
    },
    "execution_id": {"type": "string", "minLength": 6},
    "task_id": {"type": "string", "minLength": 1},
    "agent_type": {
      "type": "string",
      "enum": ["CLAUDE_CODE", "CODEX", "SUPERVISOR", "CI", "LOCAL_AUTOMATION"]
    },
    "agent_instance": {"type": "string"},
    "mission_id": {"type": "string"},
    "sprint_id": {"type": "string"},
    "requested_operation": {"type": "string", "minLength": 1},
    "affected_layers": {"type": "array", "items": {"type": "string"}},
    "affected_paths": {"type": "array", "items": {"type": "string"}},
    "selected_skill_ids": {
      "type": "array", "minItems": 1, "items": {"type": "string"}
    },
    "skill_hashes": {
      "type": "object",
      "description": "skill_id -> sha256(command_file) captured at resolution time",
      "additionalProperties": {"type": "string"}
    },
    "selected_command": {"type": "string"},
    "command_hash": {"type": "string"},
    "composition_order": {"type": "array", "items": {"type": "string"}},
    "resolution_decision": {
      "type": "string",
      "enum": [
        "REUSE_EXACT_MATCH", "REUSE_PARAMETERIZED_MATCH",
        "COMPOSE_EXISTING_SKILLS", "REPAIR_EXISTING_SKILL",
        "EXTEND_EXISTING_SKILL", "CREATE_MISSING_MICRO_SKILL"
      ]
    },
    "resolution_rationale": {"type": "string"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "required_validators": {"type": "array", "items": {"type": "string"}},
    "required_tests": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "status": {
      "type": "string",
      "enum": ["CREATED", "IN_PROGRESS", "CLOSED", "ABORTED"]
    },
    "final_outcome": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "closed_at": {"type": "string"},
    "expires_at": {
      "type": "string",
      "description": "SFC-GAP-C: manifest TTL (default 4h from created_at). A manifest lacking or past this timestamp is treated as expired -- fail closed, never perpetually live."
    },
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clean_target_scope": {"type": "boolean"},
    "input_digests": {
      "type": "object",
      "required": [
        "authorities", "product_contracts", "generators", "tools",
        "corpora", "dependency_locks", "environment"
      ],
      "properties": {
        "authorities": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "product_contracts": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "generators": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "tools": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "corpora": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "dependency_locks": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "commands_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["argv", "exit_code"],
        "properties": {
          "argv": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "test_selector": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "built_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "sha256"],
        "properties": {
          "kind": {"enum": ["sdist", "wheel", "sbom", "provenance", "signature"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "installed_import_locations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "coordination_identity": {"type": "string"},
    "proof_nodes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {"const": "skills-first-control/execution-manifest@2"}
        }
      },
      "then": {
        "required": [
          "git_commit", "target_tree_sha256", "clean_target_scope",
          "input_digests", "commands_executed", "built_artifacts",
          "installed_import_locations", "coordination_identity", "proof_nodes"
        ]
      }
    }
  ]
}
