{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NextRufloLanes",
  "description": "Schema for supervisor Ruflo lane export — Format Factory dual-orchestration",
  "type": "object",
  "required": ["sprint_id", "timestamp", "verdict", "lanes"],
  "additionalProperties": false,
  "properties": {
    "sprint_id": {
      "type": "string",
      "description": "Sprint identity for this lane export"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of export generation"
    },
    "verdict": {
      "type": "string",
      "description": "Evidence verdict that produced this lane export"
    },
    "source_bundle": {
      "type": "string",
      "description": "Path to evidence bundle that generated these lanes"
    },
    "coordinator_lane": {
      "type": "string",
      "description": "Lane ID of the coordinator (default: C0)"
    },
    "lanes": {
      "type": "array",
      "description": "List of execution lanes for Ruflo to coordinate",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["lane_id", "owner_role", "allowed_files", "forbidden_files"],
        "additionalProperties": false,
        "properties": {
          "lane_id": {
            "type": "string",
            "description": "Lane identifier (e.g. C0, C1, C2)"
          },
          "owner_role": {
            "type": "string",
            "description": "Role responsible for this lane"
          },
          "title": {
            "type": "string",
            "description": "Human-readable lane title"
          },
          "description": {
            "type": "string",
            "description": "Detailed lane description"
          },
          "allowed_files": {
            "type": "array",
            "description": "Glob patterns of files this lane may create or modify",
            "items": { "type": "string" }
          },
          "forbidden_files": {
            "type": "array",
            "description": "Glob patterns this lane must never touch",
            "items": { "type": "string" }
          },
          "dependencies": {
            "type": "array",
            "description": "Lane IDs that must complete before this lane starts",
            "items": { "type": "string" }
          },
          "tasks": {
            "type": "array",
            "description": "Task IDs from next-sprint-taskmaster.json assigned to this lane",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "blocked", "skipped"],
            "description": "Lane status — Ruflo state only, not FF authority"
          },
          "non_authoritative": {
            "type": "boolean",
            "description": "Lane state is advisory only — does not imply gate closure",
            "default": true
          }
        }
      }
    },
    "overlap_check_passed": {
      "type": "boolean",
      "description": "Whether file ownership overlap check passed before lane execution"
    },
    "notes": {
      "type": "string",
      "description": "Human-readable notes about this lane export"
    }
  },
  "examples": [
    {
      "sprint_id": "supervisor-next-sprint-20260530",
      "timestamp": "2026-05-30T16:56:03",
      "verdict": "ACCEPTED",
      "coordinator_lane": "C0",
      "lanes": [
        {
          "lane_id": "C0",
          "owner_role": "Coordinator",
          "title": "Sprint coordination and integration",
          "allowed_files": ["reports/rNN/lane-ownership.md"],
          "forbidden_files": ["AGENTS.md", "GOVERNANCE.md", "plans/master-plan.md"],
          "dependencies": [],
          "tasks": [],
          "status": "pending",
          "non_authoritative": true
        }
      ],
      "overlap_check_passed": true,
      "notes": "Generated from R77 evidence bundle"
    }
  ]
}
