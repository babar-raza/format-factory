{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item Grade",
  "description": "Supervisor grade for a single declared work item.",
  "type": "object",
  "required": ["item_id", "item_title", "declared_status", "supervisor_grade"],
  "properties": {
    "item_id": { "type": "string" },
    "item_title": { "type": "string" },
    "declared_status": { "type": "string", "enum": ["completed", "partial", "not_started", "blocked_external_gate"] },
    "supervisor_grade": {
      "type": "string",
      "enum": ["ACCEPTED", "ACCEPTED_WITH_WARNINGS", "REWORK_REQUIRED", "REJECTED", "BLOCKED_EXTERNAL_GATE", "NOT_ATTEMPTED", "NOT_IN_SCOPE", "OVERCLAIMED"]
    },
    "evidence_found": { "type": "boolean" },
    "evidence_paths": { "type": "array", "items": { "type": "string" } },
    "tests_supporting": { "type": "array", "items": { "type": "string" } },
    "tests_missing": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria_met": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria_failed": { "type": "array", "items": { "type": "string" } },
    "required_rework": { "type": "string" },
    "can_autonomously_repair": { "type": "boolean" },
    "next_prompt_instruction": { "type": "string" }
  },
  "additionalProperties": false
}
