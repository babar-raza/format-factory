{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format Factory Per-Format Certification Report",
  "description": "Schema for per-format certification status produced by the exhaustive certification plan",
  "type": "object",
  "required": ["format_id", "language", "certification_dimensions", "overall_verdict"],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "authoritative_plan": { "type": "string", "const": "plans/.claude/crispy-jingling-snail.md" },
        "mission_id": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "schema_version": { "type": "string", "const": "1.0.0" }
      }
    },
    "format_id": { "type": "string", "description": "Format identifier (e.g., fods, csv, zst)" },
    "language": { "type": "string", "enum": ["python", "dotnet", "both"] },
    "certification_dimensions": {
      "type": "object",
      "required": [
        "api_contract", "traceability", "stubs", "exceptions",
        "oracle", "test_quality", "overall_verdict"
      ],
      "properties": {
        "api_contract": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "python_api_count": { "type": "integer" },
            "dotnet_api_count": { "type": "integer" },
            "evidence_path": { "type": "string" }
          }
        },
        "traceability": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "qname_count": { "type": "integer" },
            "qname_pass_count": { "type": "integer" },
            "evidence_path": { "type": "string" }
          }
        },
        "stubs": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "material_stub_count": { "type": "integer" },
            "evidence_path": { "type": "string" }
          }
        },
        "exceptions": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "exception_count": { "type": "integer" },
            "uncovered_count": { "type": "integer" },
            "evidence_path": { "type": "string" }
          }
        },
        "oracle": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "pass_rate": { "type": "string" },
            "evidence_path": { "type": "string" }
          }
        },
        "test_quality": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE", "NOT_AUDITED"] },
            "min_score": { "type": "number" },
            "avg_score": { "type": "number" },
            "evidence_path": { "type": ["string", "null"] }
          }
        },
        "roundtrip": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "evidence_path": { "type": ["string", "null"] }
          }
        },
        "fuzz": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE", "NOT_AUDITED"] },
            "evidence_path": { "type": ["string", "null"] }
          }
        },
        "boundary": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE", "NOT_AUDITED"] },
            "evidence_path": { "type": ["string", "null"] }
          }
        },
        "cross_impl": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "evidence_path": { "type": ["string", "null"] }
          }
        },
        "package": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "evidence_path": { "type": ["string", "null"] }
          }
        },
        "consumer": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE"] },
            "evidence_path": { "type": ["string", "null"] }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE", "NOT_AUDITED"] },
            "evidence_path": { "type": ["string", "null"] }
          }
        },
        "performance": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_APPLICABLE", "NOT_AUDITED"] },
            "evidence_path": { "type": ["string", "null"] }
          }
        }
      }
    },
    "overall_verdict": {
      "type": "string",
      "enum": [
        "CERTIFIED",
        "CERTIFIED_WITH_KNOWN_GAPS",
        "NOT_CERTIFIED",
        "IN_PROGRESS",
        "NOT_STARTED"
      ]
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] }
        }
      }
    }
  }
}
