+def get_sheet_names(source: "str | bytes | Path") -> list[str]:
+    """Return a list of sheet names from a Gnumeric source (path, bytes, or str path).
+
+    Args:
+        source: Path to .gnumeric file or raw bytes.
+
+    Returns:
