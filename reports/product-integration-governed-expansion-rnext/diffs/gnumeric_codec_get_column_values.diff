+    sheets = list(model.get("sheets", []))
+    auto_name = name or f"Sheet{len(sheets) + 1}"
+    new_sheet: dict[str, Any] = {
+        "name": auto_name,
+        "cell_count": 0,
+        "cell_values": [],
