{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FormatFactory Taskcard",
  "type": "object",
  "required": ["id", "owner", "status", "allowed_paths", "forbidden_paths", "required_changes", "acceptance_checks", "evidence_paths", "verification_commands", "rollback_plan", "closeout_verdict"],
  "properties": {
    "id": {"type": "string", "pattern": "^TC-[A-Z]+-[0-9]+$"},
    "title": {"type": "string"},
    "owner": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["TODO", "IN_PROGRESS", "IMPLEMENTED", "VERIFIED", "CLOSED", "BLOCKED_LOCAL", "BLOCKED_EXTERNAL", "REWORK_REQUIRED", "DEFERRED"]
    },
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "shared_files": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "required_changes": {"type": "array", "items": {"type": "string"}},
    "acceptance_checks": {"type": "array", "items": {"type": "string"}},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "verification_commands": {"type": "array", "items": {"type": "string"}},
    "rollback_plan": {"type": "string"},
    "closeout_verdict": {
      "type": "string",
      "enum": ["OPEN", "CLOSED_VERIFIED", "CLOSED_DEFERRED", "CLOSED_BLOCKED_EXTERNAL"]
    },
    "task_master_status": {
      "type": "string",
      "description": "TM status is informational only — does NOT set closeout_verdict"
    }
  }
}
