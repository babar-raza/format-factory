{"action_id": "h8-probe-abw-001", "stream": "product", "priority": 0, "action_type": "PRODUCT_SOURCE_PATCH_BOUNDED", "preferred_backend": "LOCAL_DETERMINISTIC", "target_path": "src/python/abw/abw_codec.py", "task_id": "h8-probe-abw-001", "patch_type": "add_function", "patch_code": "def probe_abw(source):\n    \"\"\"Probe whether source is a valid ABW (AbiWord) document.\n\n    Checks for the presence of the abiword root element without full parsing.\n    Does not raise on malformed input - returns False instead.\n\n    Args:\n        source: Path to a file, bytes, or XML string to probe.\n\n    Returns:\n        True if source appears to be an ABW document, False otherwise.\n    \"\"\"\n    try:\n        raw = _read_source(source)\n        snippet = raw[:4096].decode(\"utf-8\", errors=\"replace\")\n        snippet_stripped = _strip_doctype(snippet.encode()).lstrip()\n        return snippet_stripped.lstrip().startswith(\"<abiword\")\n    except Exception:\n        return False", "insert_before": "# ---------------------------------------------------------------------------\n# Internal helpers", "also_modify": [], "allowed_write_roots": ["src/python/abw/", "reports/h6-product-source-pilot/host-run/", "reports/h6-product-source-pilot/"], "forbidden_actions": ["GIT_COMMIT", "GIT_PUSH", "GATE_APPROVAL"], "external_gate": false, "objective": "Add probe_abw() format-detection function to ABW codec", "result_path": "reports/h6-product-source-pilot/host-run/execution-result.json", "status": "done", "queued_at": "2026-06-06T12:38:00+00:00", "sprint_id": "FORMAT-FACTORY-H6-QUEUE-DRIVEN-PRODUCT-SOURCE-PILOT-001", "started_at": "2026-06-06T12:38:19.565978+00:00", "completed_at": "2026-06-06T12:40:02.281401+00:00"}
