{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrainState",
  "type": "object",
  "required": ["current_iteration", "absolute_iteration", "rollover_count", "required_targets", "terminal_state_reached", "last_updated"],
  "properties": {
    "current_iteration": {"type": "integer"},
    "absolute_iteration": {"type": "integer"},
    "rollover_count": {"type": "integer"},
    "checkpoint_reached": {"type": "boolean"},
    "required_targets": {"type": "object"},
    "active_lanes": {"type": "array"},
    "blocked_lanes": {"type": "array"},
    "rerouted_lanes": {"type": "array"},
    "completed_gaps": {"type": "array"},
    "remaining_gaps": {"type": "array"},
    "next_gap_queue": {"type": "array"},
    "machinery_status": {"type": "object"},
    "ruflo_mode": {"type": "string"},
    "supervisor_decision": {"type": "string"},
    "local_decision": {"type": "string"},
    "iteration_floor_class": {"type": "string"},
    "evidence_package_paths": {"type": "array"},
    "next_iteration_prompt_path": {"type": ["string", "null"]},
    "terminal_state_reached": {"type": "boolean"},
    "terminal_state_reason": {"type": ["string", "null"]},
    "last_updated": {"type": "string"}
  }
}
