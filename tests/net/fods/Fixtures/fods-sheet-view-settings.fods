<?xml version="1.0" encoding="UTF-8"?>
<!-- fods-sheet-view-settings.fods
     Fixture for GI-FODS-NET-001 Phase 3c: office:settings (config:config-item) tests.
     Sheet1: freeze pane rows=2, freeze pane cols=1, zoom=150, ShowGrid=false.
     License: Apache-2.0 (project-owned synthetic fixture)
     Spec: ODF 1.3 §3.10, config:config-item-set, config:config-item-map-named
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:config="urn:oasis:names:tc:opendocument:xmlns:config:1.0"
  office:mimetype="application/vnd.oasis.opendocument.spreadsheet-flat-xml"
  office:version="1.3">

  <office:settings>
    <config:config-item-set config:name="ooo:view-settings">
      <config:config-item-map-indexed config:name="Views">
        <config:config-item-map-entry>
          <config:config-item-map-named config:name="Tables">
            <config:config-item-map-entry config:name="Sheet1">
              <!-- HorizontalSplitMode=2 means freeze (not split) -->
              <config:config-item config:name="HorizontalSplitMode" config:type="short">2</config:config-item>
              <!-- HorizontalSplitPosition = number of frozen rows -->
              <config:config-item config:name="HorizontalSplitPosition" config:type="int">2</config:config-item>
              <!-- VerticalSplitMode=2 means freeze columns -->
              <config:config-item config:name="VerticalSplitMode" config:type="short">2</config:config-item>
              <!-- VerticalSplitPosition = number of frozen columns -->
              <config:config-item config:name="VerticalSplitPosition" config:type="int">1</config:config-item>
              <!-- ZoomValue: percentage (150 = 150%) -->
              <config:config-item config:name="ZoomValue" config:type="int">150</config:config-item>
              <!-- ShowGrid: false disables grid lines -->
              <config:config-item config:name="ShowGrid" config:type="boolean">false</config:config-item>
              <!-- HasColumnRowHeaders: show/hide row+column headers -->
              <config:config-item config:name="HasColumnRowHeaders" config:type="boolean">false</config:config-item>
            </config:config-item-map-entry>
          </config:config-item-map-named>
        </config:config-item-map-entry>
      </config:config-item-map-indexed>
    </config:config-item-set>
  </office:settings>

  <office:body>
    <office:spreadsheet>
      <table:table table:name="Sheet1">
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Header1</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="string">
            <text:p>Header2</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Subheader1</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="string">
            <text:p>Subheader2</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Data1</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document>
