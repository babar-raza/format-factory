<?xml version="1.0" encoding="UTF-8"?>
<!-- fods-column-widths.fods
     Fixture for GI-FODS-NET-001 Phase 3d: column width / row height resolution tests.
     Sheet1: col0 = 2.5cm wide, col1 = 5cm wide, col2 = no explicit style (default).
             row0 = 0.8cm tall (explicit), row1 = no style (default).
     Expected (via FodsStyleResolver):
       GetColumnWidth("Sheet1", 0) ≈ 70.87 pt  (2.5 * 28.3465)
       GetColumnWidth("Sheet1", 1) ≈ 141.73 pt (5.0 * 28.3465)
       GetColumnWidth("Sheet1", 2) = 0.0 pt    (no style)
       GetRowHeight("Sheet1", 0)   ≈ 22.68 pt  (0.8 * 28.3465)
     License: Apache-2.0 (project-owned synthetic fixture)
     Spec: ODF 1.3 §9.1.6 table:table-column, §15.9.1 style:column-width
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  office:mimetype="application/vnd.oasis.opendocument.spreadsheet-flat-xml"
  office:version="1.3">

  <office:automatic-styles>
    <!-- Column 0: 2.5 cm wide -->
    <style:style style:name="co1" style:family="table-column">
      <style:table-column-properties style:column-width="2.5cm" />
    </style:style>
    <!-- Column 1: 5 cm wide -->
    <style:style style:name="co2" style:family="table-column">
      <style:table-column-properties style:column-width="5cm" />
    </style:style>
    <!-- Row 0: 0.8 cm tall -->
    <style:style style:name="ro1" style:family="table-row">
      <style:table-row-properties style:row-height="0.8cm" />
    </style:style>
  </office:automatic-styles>

  <office:body>
    <office:spreadsheet>
      <table:table table:name="Sheet1">
        <table:table-column table:style-name="co1" />
        <table:table-column table:style-name="co2" />
        <table:table-column />
        <table:table-row table:style-name="ro1">
          <table:table-cell office:value-type="string">
            <text:p>Col0_2.5cm</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="string">
            <text:p>Col1_5cm</text:p>
          </table:table-cell>
          <table:table-cell office:value-type="string">
            <text:p>Col2_default</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell office:value-type="string">
            <text:p>Row1_default_height</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document>
