{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parity-report.schema.json",
  "title": "ParityReport",
  "description": "Schema for .governance/capabilities/parity-report.yaml — output of validate_parity.py",
  "type": "object",
  "required": ["generated_at", "source_versions", "total_capabilities", "parity_counts", "checks", "overall_verdict"],
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of when this report was generated"
    },
    "generated_by": {
      "type": "string",
      "description": "Tool that generated this report"
    },
    "source_versions": {
      "type": "object",
      "description": "Registry versions used as source",
      "properties": {
        "skill_registry": {"type": "string"},
        "command_registry": {"type": "string"},
        "routing_registry": {"type": "string"}
      }
    },
    "total_capabilities": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of capability entries in the compiled registry"
    },
    "parity_counts": {
      "type": "object",
      "description": "Count of capabilities by parity_status",
      "properties": {
        "FULL_PARITY":     {"type": "integer", "minimum": 0},
        "PARTIAL":         {"type": "integer", "minimum": 0},
        "ORPHAN":          {"type": "integer", "minimum": 0},
        "MISSING_COMMAND": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "description": "Individual parity check results",
      "items": {
        "type": "object",
        "required": ["check_id", "priority", "verdict"],
        "properties": {
          "check_id":   {"type": "string"},
          "priority":   {"type": "string", "enum": ["P1", "P2", "P3", "P4"]},
          "verdict":    {"type": "string", "enum": ["PASS", "FAIL", "WARN", "SKIP"]},
          "failures":   {"type": "array", "items": {"type": "string"}},
          "failure_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "overall_verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"],
      "description": "FAIL if any P1 failure; WARN if any P2 failure; PASS if no failures"
    }
  },
  "additionalProperties": false
}
