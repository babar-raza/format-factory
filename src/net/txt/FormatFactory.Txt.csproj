<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- FormatFactory.Txt — standalone .NET TXT target writer library -->
    <!-- Sprint: FORMAT-FACTORY-DOTNET-TARGET-WRITER-MWP-DOGFOOD-UNBLOCKING-001 -->
    <!-- target_ff_library: FormatFactory.Txt.TxtWriter -->
    <!-- commercial_product_ready: false — G11-G not approved -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FormatFactory.Txt</AssemblyName>
    <RootNamespace>FormatFactory.Txt</RootNamespace>
    <Version>0.1.0-mwp</Version>
    <Authors>format-factory</Authors>
    <Description>FormatFactory.Txt: Standalone .NET plain-text target writer library. MWP implementation. Not release-ready.</Description>
    <PackageId>FormatFactory.Txt</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
