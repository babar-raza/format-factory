<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- FormatFactory.Html — standalone .NET HTML target writer library -->
    <!-- Sprint: FORMAT-FACTORY-DOTNET-TARGET-WRITER-MWP-DOGFOOD-UNBLOCKING-001 -->
    <!-- target_ff_library: FormatFactory.Html.HtmlWriter -->
    <!-- commercial_product_ready: false — G11-G not approved -->
    <!-- product_class: target_writer_utility — NOT a format product. No load/parse capability. Internal dogfood export target for FODS/FODT. Exclude from format product counts. PROB-004 reclassification 2026-06-25. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FormatFactory.Html</AssemblyName>
    <RootNamespace>FormatFactory.Html</RootNamespace>
    <Version>0.1.0-alpha.1</Version>
    <Authors>format-factory</Authors>
    <Description>FormatFactory.Html: Standalone .NET HTML target writer library. MWP implementation. Not release-ready. product_class=target_writer_utility</Description>
    <PackageId>FormatFactory.Html</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
