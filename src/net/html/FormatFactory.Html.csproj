<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- FormatFactory.Html — standalone .NET HTML target writer library -->
    <!-- Sprint: FORMAT-FACTORY-DOTNET-TARGET-WRITER-MWP-DOGFOOD-UNBLOCKING-001 -->
    <!-- target_ff_library: FormatFactory.Html.HtmlWriter -->
    <!-- commercial_product_ready: false — G11-G not approved -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FormatFactory.Html</AssemblyName>
    <RootNamespace>FormatFactory.Html</RootNamespace>
    <Version>0.1.0-mwp</Version>
    <Authors>format-factory</Authors>
    <Description>FormatFactory.Html: Standalone .NET HTML target writer library. MWP implementation. Not release-ready.</Description>
    <PackageId>FormatFactory.Html</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
