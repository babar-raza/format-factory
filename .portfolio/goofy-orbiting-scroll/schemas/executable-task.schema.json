{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executable-task",
  "title": "Executable Task",
  "description": "The smallest complete unit of work that can be claimed, implemented, verified, and closed independently.",
  "type": "object",
  "required": ["schema_version","task_id","workstream_id","objective","source_plan_ids","source_task_ids","primary_lane","acceptance_criteria","evidence_requirements","status"],
  "properties": {
    "schema_version": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^ET-[A-Z0-9-]+$"},
    "workstream_id": {"type": "string", "pattern": "^WS-[A-Z0-9-]+$"},
    "objective": {"type": "string", "minLength": 10},
    "source_plan_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "source_task_ids": {"type": "array", "items": {"type": "string"}},
    "source_anchors": {"type": "array", "items": {"type": "string"}},
    "source_requirement_ids": {"type": "array", "items": {"type": "string"}},
    "affected_components": {"type": "array", "items": {"type": "string"}},
    "affected_paths": {"type": "array", "items": {"type": "string"}},
    "allowed_mutation_scope": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "shared_resources": {"type": "array", "items": {"type": "string"}},
    "primary_lane": {"type": "string"},
    "supporting_lanes": {"type": "array", "items": {"type": "string"}},
    "integration_owner": {"type": "string"},
    "implementation_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "negative_acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "focused_verification": {"type": "array", "items": {"type": "string"}},
    "lane_verification": {"type": "array", "items": {"type": "string"}},
    "integration_verification": {"type": "array", "items": {"type": "string"}},
    "regression_verification": {"type": "array", "items": {"type": "string"}},
    "end_to_end_verification": {"type": "array", "items": {"type": "string"}},
    "pilot_verification": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rollback": {"type": "string"},
    "cleanup": {"type": "string"},
    "invalidation_triggers": {"type": "array", "items": {"type": "string"}},
    "reopening_conditions": {"type": "array", "items": {"type": "string"}},
    "wave": {"type": "integer"},
    "status": {
      "type": "string",
      "enum": ["TODO","WAITING","READY","CLAIMED","IN_PROGRESS","IMPLEMENTED",
               "FOCUSED_VERIFIED","LANE_VERIFIED","INTEGRATION_VERIFIED",
               "REGRESSION_VERIFIED","END_TO_END_VERIFIED","PILOT_PROVEN",
               "INDEPENDENTLY_REVIEWED","CLOSED","REWORK_REQUIRED",
               "BLOCKED_LOCAL","BLOCKED_EXTERNAL","WAITING_FOR_DECISION",
               "INVALIDATED","REOPENED","ATTEMPT_INTERRUPTED"]
    },
    "active_claim_id": {"type": ["string","null"]},
    "active_attempt_id": {"type": ["string","null"]},
    "closure_id": {"type": ["string","null"]},
    "claimed_at": {"type": ["string","null"]},
    "closed_at": {"type": ["string","null"]},
    "last_verified_at": {"type": ["string","null"]}
  },
  "additionalProperties": false
}
