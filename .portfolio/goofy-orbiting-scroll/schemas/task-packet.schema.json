{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-packet",
  "title": "Task Packet",
  "description": "Self-contained execution context for one executable task. A worker must be able to execute from this plus direct repository inspection, without loading all 41 plans.",
  "type": "object",
  "required": ["schema_version","portfolio_id","task_id","workstream_id","objective","acceptance_criteria","implementation_steps","evidence_requirements","expected_start_state","expected_terminal_state","packet_checksum"],
  "properties": {
    "schema_version": {"type": "string"},
    "portfolio_id": {"type": "string"},
    "task_id": {"type": "string"},
    "workstream_id": {"type": "string"},
    "objective": {"type": "string"},
    "source_plan_ids": {"type": "array", "items": {"type": "string"}},
    "source_task_ids": {"type": "array", "items": {"type": "string"}},
    "source_anchors": {"type": "array", "items": {"type": "string"}},
    "original_source_text_references": {"type": "array", "items": {"type": "string"}},
    "repository_assessment": {"type": "string"},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "negative_acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "affected_components": {"type": "array", "items": {"type": "string"}},
    "affected_paths": {"type": "array", "items": {"type": "string"}},
    "allowed_mutation_scope": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "required_locks": {"type": "array", "items": {"type": "string"}},
    "primary_lane": {"type": "string"},
    "integration_owner": {"type": "string"},
    "implementation_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "focused_validation": {"type": "array", "items": {"type": "string"}},
    "lane_validation": {"type": "array", "items": {"type": "string"}},
    "integration_validation": {"type": "array", "items": {"type": "string"}},
    "regression_validation": {"type": "array", "items": {"type": "string"}},
    "end_to_end_validation": {"type": "array", "items": {"type": "string"}},
    "pilot_validation": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "string"},
    "cleanup": {"type": "string"},
    "invalidation_triggers": {"type": "array", "items": {"type": "string"}},
    "reopening_conditions": {"type": "array", "items": {"type": "string"}},
    "expected_start_state": {"type": "string"},
    "expected_terminal_state": {"type": "string"},
    "packet_checksum": {"type": "string"}
  }
}
