{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "playbook-task-binding/1.0",
  "title": "Playbook Task Binding",
  "description": "Schema for taskcard provenance bindings generated from Sprint Task Templates. Authority: every generated taskcard must preserve playbook_id, playbook_version, plan_id, gap_ids, allowed_paths, forbidden_paths, validation, rollback. Does NOT approve gates, does NOT mark work complete, does NOT replace plan authority.",
  "type": "object",
  "required": [
    "schema",
    "binding_id",
    "playbook_id",
    "playbook_version",
    "plan_id",
    "generated_at",
    "generator",
    "taskcards_generated",
    "taskcard_ids",
    "authority_statement",
    "taskcards"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "playbook-task-binding/1.0"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^BIND-[A-Z0-9]{8}$"
    },
    "playbook_id": {
      "type": "string",
      "minLength": 1
    },
    "playbook_version": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "description": "Plan ID providing authority for this taskcard generation"
    },
    "gap_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "generated_at": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "taskcards_generated": {
      "type": "integer",
      "minimum": 1
    },
    "taskcard_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "authority_statement": {
      "type": "string",
      "description": "Explicit statement that taskcards do not approve gates or replace authority"
    },
    "taskcards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/taskcard"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "taskcard": {
      "type": "object",
      "required": [
        "playbook_id",
        "playbook_version",
        "plan_id",
        "taskcard_id",
        "phase",
        "allowed_paths",
        "forbidden_paths",
        "validation",
        "evidence_requirements",
        "evidence_root",
        "rollback",
        "stop_conditions",
        "authority_constraints",
        "status"
      ],
      "properties": {
        "playbook_id": { "type": "string" },
        "playbook_version": { "type": "string" },
        "plan_id": { "type": "string" },
        "gap_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generated_at": { "type": "string" },
        "generator": { "type": "string" },
        "taskcard_id": { "type": "string" },
        "phase": { "type": "string" },
        "phase_index": { "type": "integer" },
        "total_phases": { "type": "integer" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbidden_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "task_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validation": {},
        "evidence_requirements": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "evidence_root": { "type": "string" },
        "rollback": { "type": "string" },
        "stop_conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "authority_constraints": {
          "type": "object",
          "required": [
            "no_gate_approval",
            "no_mark_work_complete_without_evidence",
            "no_plan_override",
            "no_evidence_contract_replacement",
            "limitations"
          ],
          "properties": {
            "no_gate_approval": { "type": "boolean", "const": true },
            "no_mark_work_complete_without_evidence": { "type": "boolean", "const": true },
            "no_plan_override": { "type": "boolean", "const": true },
            "no_evidence_contract_replacement": { "type": "boolean", "const": true },
            "limitations": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "IN_PROGRESS", "CLOSED", "BLOCKED"]
        },
        "owner_layer": { "type": "string" }
      }
    }
  }
}
