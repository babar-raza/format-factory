{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:format-factory:contract-research:v1",
  "title": "ContractResearchStore",
  "description": "Committed research store for the L30 research plane. Product-requirement findings (non-normative knowledge: developer use cases, API expectations, ecosystem practice) with mandatory source records and review verdicts. Normative claims do NOT belong here - they route to the SAL candidate queue and are committed by L01. Hash-bound into contract input_digests.",
  "type": "object",
  "required": ["format_id", "schema_version", "source_records", "findings"],
  "additionalProperties": false,
  "properties": {
    "format_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "schema_version": {"const": "1.0"},
    "canonical": {"type": "boolean"},
    "note": {"type": "string"},
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "authority_class", "acquisition_status"],
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 3},
          "organization": {"type": ["string", "null"]},
          "version": {"type": ["string", "null"]},
          "publication_date": {"type": ["string", "null"]},
          "canonical_url": {"type": ["string", "null"]},
          "local_path": {"type": ["string", "null"]},
          "content_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "authority_class": {"enum": ["AUTHORITATIVE", "VERIFIED_DERIVATION", "ACCEPTED_EMPIRICAL_EVIDENCE", "PRODUCT_REQUIREMENT", "AI_DRAFT", "UNVERIFIED"]},
          "relevant_sections": {"type": "array", "items": {"type": "string"}},
          "licensing": {"type": ["string", "null"]},
          "acquisition_status": {"enum": ["ACQUIRED", "URL_ONLY", "NEEDS_AUTHORITY"]}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "kind", "capability_domain", "requirement", "source_ids", "authority_class", "review"],
        "additionalProperties": false,
        "properties": {
          "finding_id": {"type": "string", "pattern": "^RF-[A-Z0-9]+-[0-9]{5}$"},
          "kind": {"enum": ["product_requirement", "developer_use_case", "api_expectation", "test_obligation", "security_expectation", "performance_expectation", "scope_decision"]},
          "capability_domain": {"type": "string", "pattern": "^[A-Z][A-Z_]+$", "description": "Family-pack domain this finding feeds (e.g. PARSE, MODEL, INLINE)."},
          "requirement": {"type": "string", "minLength": 25},
          "rationale": {"type": ["string", "null"]},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"}},
          "authority_class": {"enum": ["PRODUCT_REQUIREMENT", "ACCEPTED_EMPIRICAL_EVIDENCE"]},
          "depth_hint": {"type": "integer", "minimum": 0, "maximum": 8},
          "api_expectations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "root_types": {"type": "array", "items": {"type": "string"}},
              "domain_types": {"type": "array", "items": {"type": "string"}},
              "read_operations": {"type": "array", "items": {"type": "string"}},
              "mutation_operations": {"type": "array", "items": {"type": "string"}},
              "validation_operations": {"type": "array", "items": {"type": "string"}},
              "serialization_operations": {"type": "array", "items": {"type": "string"}},
              "diagnostic_types": {"type": "array", "items": {"type": "string"}},
              "api_rules": {"type": "array", "items": {"type": "string"}}
            }
          },
          "required_tests": {"type": "array", "items": {"type": "string", "minLength": 10}},
          "release_gates": {"type": "array", "items": {"type": "string", "minLength": 10}},
          "required_model_objects": {"type": "array", "items": {"type": "string"}},
          "required_operations": {"type": "array", "items": {"type": "string"}},
          "required_invariants": {"type": "array", "items": {"type": "string"}},
          "preservation_rules": {"type": "array", "items": {"type": "string"}},
          "validation_rules": {"type": "array", "items": {"type": "string"}},
          "security_requirements": {"type": "array", "items": {"type": "string"}},
          "performance_requirements": {"type": "array", "items": {"type": "string"}},
          "error_behavior": {"type": "array", "items": {"type": "string"}},
          "review": {
            "type": "object",
            "required": ["verdict", "reviewer"],
            "additionalProperties": false,
            "properties": {
              "verdict": {"enum": ["ACCEPTED", "ACCEPTED_WITH_EDITS", "REJECTED", "PENDING"]},
              "reviewer": {"type": "string", "minLength": 3},
              "reviewed_at": {"type": ["string", "null"]},
              "notes": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
