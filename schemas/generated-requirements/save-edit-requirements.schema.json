{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "save-edit-requirements.schema.json",
  "title": "Save and Edit Requirements",
  "description": "Schema for save, edit, and round-trip requirements",
  "type": "object",
  "required": ["format", "generator_version", "generation_timestamp", "requirements"],
  "additionalProperties": false,
  "properties": {
    "format": {"type": "string", "enum": ["fods", "fodt"]},
    "generator_version": {"type": "string"},
    "generation_timestamp": {"type": "string"},
    "model_tool": {"type": "string"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "category", "title", "description", "source_type", "confidence", "status"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": {"type": "string"},
          "category": {"type": "string", "enum": ["edit", "save", "roundtrip", "preservation", "validation"]},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "product_goal_mapping": {"type": ["array", "null"], "items": {"type": "string"}},
          "source_type": {"type": "string", "enum": ["SPEC", "VERIFIED_FACT", "PRODUCT_DECISION", "EXISTING_SOURCE", "TEST_EVIDENCE", "AI_PROPOSAL"]},
          "source_evidence": {"type": ["array", "null"]},
          "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "status": {"type": "string", "enum": ["GENERATED", "ACCEPTED", "REJECTED", "NEEDS_REVIEW", "ACCEPTED_FOR_VERTICAL_SLICE"]},
          "test_requirements": {"type": ["array", "null"], "items": {"type": "string"}},
          "known_limitations": {"type": ["string", "null"]},
          "validation_notes": {"type": ["string", "null"]}
        }
      },
      "minItems": 1
    }
  }
}
