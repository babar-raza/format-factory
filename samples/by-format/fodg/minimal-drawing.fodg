<?xml version="1.0" encoding="UTF-8"?>
<!--
  minimal-drawing.fodg
  format-factory / samples/by-format/fodg/

  Sample ID: fodg-minimal-01
  Category: minimal
  Gate: 3
  License: Apache-2.0
  Provenance: project-owned synthetic (Apache-2.0, no external rights)
  Generated: R19 (2026-05-16)

  Spec basis:
    §3.1.2  office:document root element (ODF 1.3)
    §3.5    office:drawing body element
    §9.2    draw:page drawing page structure

  This is the minimal conforming FODG document:
  - Single drawing page
  - One rectangle shape
  - All required namespaces declared
  - office:mimetype set to flat-xml graphics MIME type
  - office:version set to 1.3
-->
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.graphics-flat-xml"
    office:version="1.3">
  <office:body>
    <office:drawing>
      <draw:page draw:name="Page1" draw:style-name="">
        <draw:rect svg:x="2cm" svg:y="2cm" svg:width="10cm" svg:height="5cm">
          <text:p>Rectangle</text:p>
        </draw:rect>
      </draw:page>
    </office:drawing>
  </office:body>
</office:document>
