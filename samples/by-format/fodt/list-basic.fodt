<?xml version="1.0" encoding="UTF-8"?>
<!--
  FODT Sample: list-basic.fodt
  Format: FODT (Flat OpenDocument Text) — ODF 1.3
  Purpose: Text document with a bullet list and a numbered list.
           Tests text:list, text:list-item, and list-style references.
  Gate: 3 (Sample Corpus) — format-factory project
  License: Apache-2.0
  Author: format-factory project (synthetic, project-owned)
  Created: 2026-05-08 (run043)
  Spec: ODF 1.3, Part 2 §5.3 (Text Lists), §5.3.1 (text:list element),
        §5.3.2 (text:list-item element)
  MIME type: application/vnd.oasis.opendocument.text-flat-xml
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  office:version="1.3"
  office:mimetype="application/vnd.oasis.opendocument.text-flat-xml">
  <office:automatic-styles>
    <text:list-style style:name="BulletList">
      <text:list-level-style-bullet text:level="1" text:bullet-char="&#x2022;">
        <style:list-level-properties text:space-before="0.635cm" text:min-label-width="0.635cm"/>
      </text:list-level-style-bullet>
    </text:list-style>
    <text:list-style style:name="NumberedList">
      <text:list-level-style-number text:level="1" style:num-format="1" style:num-suffix=".">
        <style:list-level-properties text:space-before="0.635cm" text:min-label-width="0.635cm"/>
      </text:list-level-style-number>
    </text:list-style>
  </office:automatic-styles>
  <office:body>
    <office:text>
      <text:p>Bullet list example:</text:p>
      <text:list text:style-name="BulletList">
        <text:list-item>
          <text:p>First bullet item</text:p>
        </text:list-item>
        <text:list-item>
          <text:p>Second bullet item</text:p>
        </text:list-item>
        <text:list-item>
          <text:p>Third bullet item</text:p>
        </text:list-item>
      </text:list>
      <text:p>Numbered list example:</text:p>
      <text:list text:style-name="NumberedList">
        <text:list-item>
          <text:p>Step one</text:p>
        </text:list-item>
        <text:list-item>
          <text:p>Step two</text:p>
        </text:list-item>
        <text:list-item>
          <text:p>Step three</text:p>
        </text:list-item>
      </text:list>
    </office:text>
  </office:body>
</office:document>
