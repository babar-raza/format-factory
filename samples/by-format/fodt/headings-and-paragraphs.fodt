<?xml version="1.0" encoding="UTF-8"?>
<!--
  FODT Sample: headings-and-paragraphs.fodt
  Format: FODT (Flat OpenDocument Text) — ODF 1.3
  Purpose: Text document with Heading 1, Heading 2, and paragraph elements.
           Tests heading style references and paragraph hierarchy.
  Gate: 3 (Sample Corpus) — format-factory project
  License: Apache-2.0
  Author: format-factory project (synthetic, project-owned)
  Created: 2026-05-08 (run043)
  Spec: ODF 1.3, Part 2 §3.1 (Headings), §5.1 (Paragraphs), §5.3 (Heading elements)
  MIME type: application/vnd.oasis.opendocument.text-flat-xml
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  office:version="1.3"
  office:mimetype="application/vnd.oasis.opendocument.text-flat-xml">
  <office:automatic-styles>
    <style:style style:name="Heading1Auto" style:family="paragraph" style:parent-style-name="Heading_20_1">
      <style:paragraph-properties fo:margin-top="0.423cm" fo:margin-bottom="0.212cm"/>
    </style:style>
    <style:style style:name="Heading2Auto" style:family="paragraph" style:parent-style-name="Heading_20_2">
      <style:paragraph-properties fo:margin-top="0.353cm" fo:margin-bottom="0.212cm"/>
    </style:style>
  </office:automatic-styles>
  <office:body>
    <office:text>
      <text:h text:outline-level="1">Section One</text:h>
      <text:p>This is the first paragraph under Section One. It contains plain text content.</text:p>
      <text:p>This is the second paragraph under Section One.</text:p>
      <text:h text:outline-level="2">Subsection One A</text:h>
      <text:p>This paragraph is under the subsection. It demonstrates nested heading structure.</text:p>
      <text:h text:outline-level="1">Section Two</text:h>
      <text:p>First paragraph of Section Two.</text:p>
    </office:text>
  </office:body>
</office:document>
