<?xml version="1.0" encoding="UTF-8"?>
<!--
  minimal-presentation.fodp
  format-factory / samples/by-format/fodp/

  Sample ID: fodp-minimal-01
  Category: minimal
  Gate: 3
  License: Apache-2.0
  Provenance: project-owned synthetic (Apache-2.0, no external rights)
  Generated: R19 (2026-05-16)

  Spec basis:
    §3.1.2  office:document root element (ODF 1.3)
    §3.6    office:presentation body element
    §9.1    draw:page slide/page structure

  This is the minimal conforming FODP document:
  - Single slide (draw:page)
  - Title text frame with "Hello"
  - All required namespaces declared
  - office:mimetype set to flat-xml presentation MIME type
  - office:version set to 1.3
-->
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.presentation-flat-xml"
    office:version="1.3">
  <office:body>
    <office:presentation>
      <draw:page draw:name="Slide1" draw:style-name="">
        <draw:frame draw:name="title" presentation:class="title"
            svg:x="1.5cm" svg:y="1.5cm" svg:width="20cm" svg:height="3cm">
          <draw:text-box>
            <text:p>Hello</text:p>
          </draw:text-box>
        </draw:frame>
      </draw:page>
    </office:presentation>
  </office:body>
</office:document>
