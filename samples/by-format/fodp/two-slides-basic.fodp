<?xml version="1.0" encoding="UTF-8"?>
<!--
  two-slides-basic.fodp
  format-factory / samples/by-format/fodp/

  Sample ID: fodp-two-slides-01
  Category: basic
  Gate: 3
  License: Apache-2.0
  Provenance: project-owned synthetic (Apache-2.0, no external rights)
  Generated: R19 (2026-05-16)

  Spec basis:
    §3.1.2  office:document root element (ODF 1.3)
    §3.6    office:presentation body element
    §9.1    draw:page slide/page structure

  Two-slide FODP document:
  - Slide 1: Title "Introduction" with body text
  - Slide 2: Title "Conclusion"
  - Tests multi-page presentation parsing
-->
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    office:mimetype="application/vnd.oasis.opendocument.presentation-flat-xml"
    office:version="1.3">
  <office:body>
    <office:presentation>
      <draw:page draw:name="Slide1" draw:style-name="">
        <draw:frame draw:name="title1" presentation:class="title"
            svg:x="1.5cm" svg:y="1.5cm" svg:width="20cm" svg:height="3cm">
          <draw:text-box>
            <text:p>Introduction</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:name="content1" presentation:class="body"
            svg:x="1.5cm" svg:y="5cm" svg:width="20cm" svg:height="10cm">
          <draw:text-box>
            <text:p>First slide content.</text:p>
          </draw:text-box>
        </draw:frame>
      </draw:page>
      <draw:page draw:name="Slide2" draw:style-name="">
        <draw:frame draw:name="title2" presentation:class="title"
            svg:x="1.5cm" svg:y="1.5cm" svg:width="20cm" svg:height="3cm">
          <draw:text-box>
            <text:p>Conclusion</text:p>
          </draw:text-box>
        </draw:frame>
      </draw:page>
    </office:presentation>
  </office:body>
</office:document>
