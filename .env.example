# format-factory — required environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# This file (.env.example) is committed as a template with placeholder values only.

# ============================================================
# LLM ENDPOINTS
# ============================================================

# Anthropic Claude API key (agent-native primary executor)
ANTHROPIC_API_KEY=

# OpenAI / Codex API key (optional secondary executor or reviewer)
OPENAI_API_KEY=

# llm.professionalize.com remote endpoint key
PROFESSIONALIZE_API_KEY=

# ============================================================
# LOCAL LLM ENDPOINTS (no key required, but URL configurable)
# ============================================================

# Local Ollama endpoint (default: http://localhost:11434)
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1

# Local LM Studio endpoint (default: http://localhost:1234)
LOCAL_LM_STUDIO_ENDPOINT=http://localhost:1234/v1

# Custom local endpoint (leave blank if not used)
LOCAL_CUSTOM_ENDPOINT=

# ============================================================
# NOTES
# ============================================================
# 1. Do not add real values here. Use .env for real values.
# 2. See docs/llm-endpoint-strategy.md for endpoint policy.
# 3. See tools/llm/endpoints.yaml for endpoint configuration.
# 4. No API calls are made in Phase 0.
