{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervisor_verdict_packet.schema.json",
  "title": "SupervisorVerdictPacket",
  "type": "object",
  "required": [
    "packet_id", "generated_at", "source_graph_hash", "claims_checked",
    "coverage_records", "overclaim_risks", "stale_claims", "unsupported_features",
    "poc_readiness_verdict", "mainstream_gap_queue_ref", "recommended_supervisor_decision",
    "false_pass_risks", "false_stop_risks", "stream_consumption_status",
    "external_tool_boundary", "evidence_package_refs"
  ],
  "properties": {
    "packet_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "source_graph_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "claims_checked": {"type": "integer", "minimum": 0},
    "coverage_records": {"type": "array"},
    "overclaim_risks": {"type": "array"},
    "stale_claims": {"type": "array"},
    "unsupported_features": {"type": "array"},
    "poc_readiness_verdict": {"type": "object"},
    "mainstream_gap_queue_ref": {"type": "string"},
    "recommended_supervisor_decision": {
      "type": "string",
      "enum": [
        "ACCEPT_PRODUCT_PROGRESS",
        "ACCEPT_WITH_LIMITATIONS",
        "REJECT_OVERCLAIM",
        "BLOCK_MISSING_DOGFOOD",
        "BLOCK_MISSING_REQUIREMENT",
        "BLOCK_STALE_PROOF",
        "CONTINUE_MAINSTREAM_WITH_GAP_QUEUE",
        "CONTINUE_WITH_REROUTE",
        "NEEDS_POLICY_DECISION"
      ]
    },
    "false_pass_risks": {"type": "array", "minItems": 0},
    "false_stop_risks": {"type": "array", "minItems": 0},
    "stream_consumption_status": {"type": "object"},
    "external_tool_boundary": {"type": "string"},
    "evidence_package_refs": {"type": "array"}
  }
}
