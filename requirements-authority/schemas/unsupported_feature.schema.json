{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unsupported_feature.schema.json",
  "title": "UnsupportedFeature",
  "type": "object",
  "required": ["node_id", "node_type", "feature_name", "severity", "claim_id", "discovered_at"],
  "properties": {
    "node_id": {"type": "string"},
    "node_type": {"type": "string", "const": "UnsupportedFeature"},
    "feature_name": {"type": "string"},
    "severity": {"type": "string", "enum": ["blocking", "non_blocking"]},
    "claim_id": {"type": "string"},
    "discovered_at": {"type": "string"},
    "declared_by": {"type": "string"},
    "description": {"type": "string"},
    "resolution_path": {"type": ["string", "null"]}
  }
}
