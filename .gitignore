# format-factory .gitignore
# Phase 0 Foundation — this file must be committed before anything else.

# ============================================================
# LOCAL-ONLY EXECUTION DATA (never commit)
# ============================================================
.local/
.local/**

# ============================================================
# SECRETS AND CREDENTIALS (never commit)
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
*.egg
.tox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ============================================================
# .NET / C#
# ============================================================
bin/
obj/
*.dll
*.pdb
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.nupkg
*.snupkg
TestResults/
BenchmarkDotNet.Artifacts/

# ============================================================
# NODE (present but not primary)
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# STRAY ARTIFACTS (machine-generated, not project files)
# ============================================================
json
ff.zip
src/src.zip
format-factory.zip

# ============================================================
# OS ARTIFACTS
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================
# EDITOR / IDE
# ============================================================
*.log
*.tmp
*.swp
*.swo
*~
.idea/
*.sublime-workspace

# ============================================================
# LARGE BINARY SAMPLES (use Git LFS per samples/_policy.md)
# ============================================================
# Actual LFS tracking is configured via .gitattributes when needed.
# Do not add binary sample files without an LFS policy entry.

# ============================================================
# NESTED DUPLICATE PACKAGE PREVENTION
# Self-nested format directories (e.g. src/python/fods/fods/) are structural
# violations. V246 validator blocks sprints when these exist. This gitignore
# entry prevents accidental re-commitment of the fods/fods/ directory that
# was removed in the skills-first anti-ad-hoc healing sprint (2026-07-16).
# ============================================================
src/python/*/build/
src/python/*/__pycache__/
src/python/fods/fods/

# ============================================================
# IN-PROGRESS SPRINT ARTIFACTS (untracked, not yet committed)
# ============================================================

# ============================================================
# GENERATED EVIDENCE BUNDLES (local only, upload manually)
# ============================================================
# Evidence bundles live in evidence-bundles/ but must NOT be committed.
# Large ZIP files cause repository bloat. Use .local/evidence-bundles/ for staging.
evidence-bundles/*.zip

# ============================================================
# REPORTS EVIDENCE SUBFOLDER (if accidentally created)
# ============================================================
reports/evidence/


# ============================================================
# BUNDLE-METADATA STAGING (generated by build_evidence_bundle.py)
# This directory is a local staging area and must not be committed.
# ============================================================
bundle-metadata/

# ============================================================
# LANE F (AI PLATFORM PLAN) — IN-PROGRESS SEPARATE SPRINT
# These files belong to a future sprint and are excluded from
# R24 to maintain a clean git status for evidence bundle builds.
# ============================================================
reports/ai/ai-platform-*/
reports/ai/ai-platform-final-deep-plan-healing-*/


# ============================================================
# R58 Train M: Sidecar proof files must never be committed
# INV-006: .sha256-proof.json sidecars are external to ZIP,
# stored in .local/ or reports/ but NOT git-tracked.
# ============================================================
reports/**/*.sha256-proof.json
.local/**/*.sha256-proof.json
docs/_audit/
reports/capability-layer/*.backup-*

# ============================================================
# LOCAL SUPERVISOR CONTROL PLANE — runtime state (gitignored)
# Tracked files: .supervisor/config.yaml, policies.yaml,
#   project-memory.md, sprint-loop.md, prompts/, schemas/
# Gitignored state (runtime only):
# ============================================================
.supervisor/state/

# ============================================================
# TASK MASTER AI — local config/secrets/state
# ============================================================
.vscode/mcp.json
.env.taskmaster
.taskmaster/.env
.taskmaster/config.local.json

# ============================================================
# RUFLO (claude-flow) — local config/state/secrets
# ============================================================
.env.ruflo
.ruflo/.env
.ruflo/config.local.json
.ruflo/state/
.ruflo/logs/
.swarm/
.local/ruflo/

# Temporary scratch directories
tmp/
temp/
output*/

# External orchestration tool runtime state
.claude-flow/
.claude-flow-state/

# Runner system identity (session-specific, not a repo artifact)
.runner_system_id
/.supervisor/state
